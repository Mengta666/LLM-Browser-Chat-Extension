ARG CUDA_IMAGE=nvidia/cuda:12.8.1-base-ubuntu24.04
FROM ${CUDA_IMAGE}
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    PATH=/opt/venv/bin:$PATH HOME=/home/vllm
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-venv python3-dev ca-certificates gcc g++ libnuma1 libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/venv
COPY deploy/pdf-parser/requirements-vllm-cu128.txt /opt/requirements-vllm-cu128.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install --only-binary=vllm,torch,torchvision,torchaudio \
      --extra-index-url https://download.pytorch.org/whl/cu128 \
      -r /opt/requirements-vllm-cu128.txt \
    && python -m pip check \
    && python -c "import torch, importlib.metadata as m; assert torch.version.cuda == '12.8'; assert m.version('vllm') == '0.11.1'" \
    && useradd --uid 10001 --create-home vllm
RUN chown -R 10001:10001 /home/vllm
USER 10001:10001
ENTRYPOINT ["python", "-m", "vllm.entrypoints.openai.api_server"]
