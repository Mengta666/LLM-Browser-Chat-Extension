# 复制本文件为 .env 后填入真实值：  cp .env.example .env
# .env 已被 gitignore，不会提交；本示例文件不含任何密钥。
# 修改配置后重启后端；进程/IDE 已有的同名环境变量优先于本文件。

# ═══════════════════════════════════════════════════
# LLM（对话 + Agent + 记忆抽取共用）
# ═══════════════════════════════════════════════════

# OpenAI 兼容接口地址（需带 /v1）
MODEL_BASE_URL=https://api.openai.com/v1

# LLM API Key
OPENAI_API_KEY=sk-your-key-here

# Agent 调用模式:
#   tool_calls  —— 支持 function calling 的模型（GPT-4o、Claude 等）
#   text_parse  —— 不支持 tool calling 的推理模型（DeepSeek 等），靠 prompt 解析 JSON
#   auto        —— 先试 tool_calls，失败自动降级（推荐）
AGENT_MODE=auto

# 记忆抽取 / 摘要 / rethink 使用的模型 ID；需在 MODEL_BASE_URL 对应服务中可用。
# 未设置时依次回退到 AGENT_MODEL、代码内置模型名，不会自动查询服务的默认模型。
MEMORY_MODEL=gpt-4o-mini

# Agent 截图调试开关（1=开，0=关）
AGENT_DEBUG_SCREENSHOT=0

# 自动化字段物料：单次模型输入/输出空间，不是整个任务的累计知识库额度。
# 修改后重启后端；仍使用所选自动化模型，不改变聊天推理设置。
# 取材单次输入上限；还受 CHAT_CONTEXT_LENGTH、实际模型窗口、输出及安全预留约束。
AGENT_MATERIAL_CONTEXT_TOKENS=12000
# 取材输出上限，以及绑定知识库时未另行设置的自动化决策输出上限。
AGENT_MATERIAL_OUTPUT_TOKENS=8192
# 每次 prepare_materials 的字段数；不是整个任务字段总数。
AGENT_MATERIAL_MAX_FIELDS=24
# 连续无新证据或提取格式无法纠正时结束取材，禁止无限重试。
AGENT_MATERIAL_NO_PROGRESS_ROUNDS=3

# ═══════════════════════════════════════════════════
# 服务端聊天上下文与输出预算（单位：tokens，计数模式见下方）
# ═══════════════════════════════════════════════════

# 必须按实际部署模型的上下文窗口填写，不能仅按模型宣传值设置。
# 输入额度 = 上下文窗口 - 回复输出上限 - 安全余量。
CHAT_CONTEXT_LENGTH=128000
# 单次模型回复输出上限；提高此值会减少可用输入额度。
# 达到上限且已有正文时保存为未完成回答，用户可手动继续生成。
CHAT_MAX_OUTPUT_TOKENS=8192
# 可选：仅对精确匹配的聊天模型启用推理强度；先确认上游支持 chat_template_kwargs.reasoning_effort。
# Qwen3.8 支持 low / medium / xhigh（上游默认）；留空不发送，不适用于所有模型。
# 作用于聊天、工具决策、最终正文及会话全文分析；不改变摘要、长期记忆和浏览器自动化。
CHAT_REASONING_MODEL=
# 这是软强度，不是思考 token 硬上限，也不会关闭思考；总输出仍含推理并受上面的上限约束。
CHAT_REASONING_EFFORT=
# 独立最终回答阶段的可选策略，仅应用于精确匹配模型；留空不改变模型参数。
CHAT_FINAL_MODEL=
# 0=不发送此参数；正整数需小于 CHAT_MAX_OUTPUT_TOKENS，给正文留输出空间。
# 需同时确认上游 vLLM、reasoning parser 和中间代理支持 thinking_token_budget；不自动升级或忽略不支持错误。
CHAT_FINAL_THINKING_TOKEN_BUDGET=0
# reduce_evidence=保持推理设置，仅空回答等可精简证据补救；只有推理且输出耗尽时不重复相同策略。
# non_thinking=显式允许第二次收尾关闭思考一次，需模型支持 enable_thinking=false；工具决策/自动化不变。
CHAT_FINAL_REPAIR_MODE=reduce_evidence
# 知识库最终回答专用覆盖；精确匹配实际模型 ID。默认关闭，不影响工具决策/普通聊天/自动化。
KB_ANSWER_REASONING_MODEL=
# 留空继承 CHAT_REASONING_* / 上游默认；可选 low / medium / xhigh。软强度，不是硬思考预算。
KB_ANSWER_REASONING_EFFORT=
# 0 继承 CHAT_MAX_OUTPUT_TOKENS；正整数覆盖知识库最终回答（含推理）的总输出上限，如 16384。
# 输入会按此上限重新预留空间，仍受模型实际窗口、安全余量、停止和整轮超时约束。
# 开启任一覆盖后，知识库统一独立收尾；旧 bounded 请求仍保留原工具流程。
KB_ANSWER_MAX_OUTPUT_TOKENS=0
# 给 tokenizer 估算误差和请求包装预留的安全余量。
CHAT_CONTEXT_SAFETY_TOKENS=2048
# 可选 vLLM 完整聊天请求计数接口，填写完整 /tokenize 地址；留空使用本地保守估算。
# 必须与聊天模型使用同一份 tokenizer 和聊天模板；仅后端访问，不要直接裸露到公网。
CHAT_TOKENIZER_URL=
# 只为这个聊天模型 ID 使用上述接口；其他模型不混用分词器，回退本地估算。
CHAT_TOKENIZER_MODEL=
# 分词接口单独的访问凭证；不复用 MODEL_BASE_URL 的密钥。内网无鉴权可留空。
CHAT_TOKENIZER_API_KEY=
# HTTP各阶段超时（秒，上限5秒）；单轮远程计数时间预算8秒，耗尽或首次失败后本轮不再请求。
CHAT_TOKENIZER_TIMEOUT=2
# 实际计数乘此系数后参与预算判断，1.05 表示额外留5%；最小为1。
# 本地降级估算仍使用25%余量；图片请求、网页分块暂用本地估算，状态提取分批使用对应模型计数器。
CHAT_TOKENIZER_SAFETY_RATIO=1.05
# 完整请求占输入额度的比例达到此值后，先完成历史压缩再回答。
CHAT_COMPACT_TRIGGER_RATIO=0.70
# 仅旧客户端兼容入口使用；服务端聊天不再使用此同步/后台分界。
CHAT_COMPACT_HARD_RATIO=0.90
# 压缩后的目标输入比例；建议小于触发比例，实际仍须通过完整请求预算检查。
CHAT_COMPACT_TARGET_RATIO=0.50
# 压缩时优先保留最近多少对用户/助手消息原文。
CHAT_COMPACT_KEEP_PAIRS=3
# 仅旧客户端文字摘要入口的生成目标；服务端状态提取不以此限制中间结果。
CHAT_COMPACT_SUMMARY_TARGET_TOKENS=600
# 服务端状态视图的常规预算；旧客户端仍将此作为文字摘要上限。
CHAT_COMPACT_SUMMARY_MAX_TOKENS=900
# 状态视图硬上限：必保任务/约束可使用常规预算之外的空间，超过此值明确失败，不静默截断。
CHAT_CONTEXT_STATE_MAX_TOKENS=2048
# 单批状态提取的完整输入上限；还会扣除模型输出预留、安全余量并遵守实际窗口。
CHAT_COMPACT_BATCH_TOKENS=16000
# 状态提取模型单次调用的输出上限，与最终回答输出上限、状态视图预算独立。
CHAT_COMPACT_MAX_OUTPUT_TOKENS=4096
# 摘要专用模型；留空沿用 MEMORY_MODEL，不影响对话和记忆提取模型。
CHAT_COMPACT_MODEL=
# 仅确认上游支持 chat_template_kwargs.enable_thinking 后填写 true/false。
# 留空不发送该参数。不要将此开关用于不支持该模板参数的服务。
CHAT_COMPACT_ENABLE_THINKING=
# 秒：单次摘要调用、一次压缩执行、整个用户请求的时间上限。
CHAT_COMPACT_CALL_TIMEOUT=90
CHAT_COMPACT_TIMEOUT=360
# 含压缩和回答，服务端上限为 570 秒，须低于扩展 600 秒等待上限。
CHAT_TURN_TIMEOUT=540
# 服务端聊天：等待首个有效正文/推理/工具参数的秒数；不是整次生成上限。
CHAT_LLM_FIRST_RESPONSE_TIMEOUT=120
# 有效输出之间允许停滞的秒数；空心跳不续期。整轮仍受 CHAT_TURN_TIMEOUT 硬截止约束。
CHAT_LLM_IDLE_TIMEOUT=60
# 近期历史进入模型的投影额度（不是原文存储上限，也不改变压缩触发比例）。
CHAT_RECENT_TOKENS=4000
CHAT_RECENT_MESSAGE_TOKENS=2000
# 收尾完整输入的目标额度；当前问题、受保护状态不按此目标静默丢弃，仍受完整窗口硬限制。
CHAT_FINAL_INPUT_TOKENS=8000
CHAT_FINAL_REPAIR_TOKENS=4000
# 每批每阶段仅对临时网络/429/5xx错误重试；包含首次调用，最多允许5次。
CHAT_COMPACT_MAX_ATTEMPTS=2
# 全文分析：每片/汇总的完整输入上限，仍受实际模型窗口、输出预留和安全余量限制。
# 仅在用户明确要求全文分析时使用；普通历史增强仍固定4000 tokens、最多4次工具调用。
CHAT_DOCUMENT_BATCH_TOKENS=8000
# 单次保存的分析正文上限，不包含隐藏推理；生成含推理沿用 CHAT_MAX_OUTPUT_TOKENS。
# 每次用户请求最多16次辅助分析/汇总调用，至少预留2次汇总；停止后须明确继续。
CHAT_DOCUMENT_OUTPUT_TOKENS=1024

# Chat 单图附件：模型服务器必须能访问该后端地址，不带 /v1，不要填模型地址。
# 留空禁用附件上传；纯文字聊天不受影响。仅部署于可信内网，签名不替代登录鉴权。
CHAT_ATTACHMENT_BASE_URL=
# 独立随机密钥，至少32字符；生成一次并持久保存，禁止提交/打印。
CHAT_ATTACHMENT_SIGNING_KEY=
# 图片访问链接有效期（秒，600～86400）；仅调用模型/预览前签发。
CHAT_ATTACHMENT_URL_TTL_SECONDS=900

# ═══════════════════════════════════════════════════
# Embedding
# ═══════════════════════════════════════════════════

EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=sk-your-key-here

# 模型输出维度须与 MEMORY_VECTOR_SIZE / KNOWLEDGE_VECTOR_SIZE / QDRANT_VECTOR_SIZE 一致
EMBEDDING_MODEL=text-embedding-3-small

# ═══════════════════════════════════════════════════
# 长期记忆（Qdrant）
# ═══════════════════════════════════════════════════

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=browser_pages
# 向量维度：必须与 embedding 模型输出一致，换模型时同步修改并重建 collection
QDRANT_VECTOR_SIZE=4096
QDRANT_DISTANCE=Cosine

# 记忆子系统向量维度（须与 EMBEDDING_MODEL 输出一致）
MEMORY_VECTOR_SIZE=4096

# ═══════════════════════════════════════════════════
# 联网搜索（SearXNG）
# ═══════════════════════════════════════════════════

# 1=允许模型自动搜索，0=关闭自动搜索；不禁用前端手动搜索按钮。
SEARCH_ENABLED=0
# SearXNG JSON 搜索接口完整地址，需包含 /search。
# 若使用本项目 deploy/compose.yaml，默认宿主机端口为 19080。
SEARXNG_API_URL=http://localhost:8888/search
# 每次搜索最多返回多少条结果，不是一次用户提问允许的搜索次数。
SEARCH_RESULT_COUNT=5
# 单次搜索请求超时（秒）；仍受整轮对话剩余时间限制。
SEARCH_TIMEOUT=20

# ═══════════════════════════════════════════════════
# 可选网页正文增强（独立 web-reader 服务）
# ═══════════════════════════════════════════════════

# 1=开启正文读取，0=关闭；读取失败仍保留搜索摘要并标记失败原因。
WEB_READER_ENABLED=0
# 后端能够访问的服务基址，不含 /v1/extract；远端部署时替换回环地址。
WEB_READER_API_URL=http://127.0.0.1:19081
# 与 reader 部署配置中的密钥一致，至少 32 个 ASCII 字符；不要提交真实密钥。
WEB_READER_API_KEY=
# 每次搜索最多读取的去重页面数（1～5）；不是整轮的 token 额度。
WEB_READER_MAX_PAGES=3
# 每次搜索的正文增强超时（2～30 秒），同时受整轮剩余时间限制。
WEB_READER_TIMEOUT=20
# 单次用户提问内正文+摘要共享的估算额度（128～16000 tokens）。
# 多次搜索共用，相同来源块不重复注入；下一条用户问题重新计数。
# 实际纳入量还受完整请求剩余额度限制，不是固定每次注入 6000。
# 非目标模型精确 tokenizer；历史/工具/标题/URL 另计入完整请求预算。
WEB_READER_CONTEXT_TOKENS=6000

# ═══════════════════════════════════════════════════
# 知识库（页面 RAG）
# ═══════════════════════════════════════════════════

# 存储后端: json(本地文件) | qdrant_mongo(生产)
KNOWLEDGE_BACKEND=json

KNOWLEDGE_MIN_SCORE=0.65
KNOWLEDGE_TOP_K=1
KNOWLEDGE_VEC_MIN=0.55
KNOWLEDGE_DEDUP_SCORE=0.82

# 向量维度（须与 EMBEDDING_MODEL 输出一致；text-embedding-3-small=1536）
KNOWLEDGE_VECTOR_SIZE=1536

# ═══════════════════════════════════════════════════
# MongoDB（知识库 qdrant_mongo 后端，暂未启用）
# ═══════════════════════════════════════════════════

KNOWLEDGE_QDRANT_COLLECTION=agent_operations
MONGODB_URL=
MONGODB_DB=browser_agent

# ═══════════════════════════════════════════════════
# Reranker 配置（可选，提升 KB 检索精度）
# ═══════════════════════════════════════════════════

# 是否启用 Reranker；文档候选数量、精排数量和最终证据数量分别配置。
KB_RERANK_ENABLED=false

# Reranker API 地址（zerank-2 示例: https://api.zerank.ai/v1/rerank）
KB_RERANK_API_URL=

# Reranker API Key；当前适配器要求非空，无鉴权服务也需填写服务接受的占位值。
KB_RERANK_API_KEY=

# Reranker 模型（zerank-2 / bge-reranker-v2-m3 / cohere-rerank-3.5）
KB_RERANK_MODEL=zerank-2

# 兼容旧精排调用的 top N；结构化文档链路使用下方 KB_DOCUMENT_RERANK_K。
KB_RERANK_TOP_K=5

# 兼容旧调用；结构化文档检索不再将此阈值用于 RRF 融合分。
KB_RECALL_MIN_SCORE=0.5

# KB 切片重叠长度（tokens），默认 0；应结合自己的文档检索效果调整。
KB_CHUNK_OVERLAP=0

# ═══════════════════════════════════════════════════
# PDF 结构化知识库（后端配置，不是 OCR 容器配置）
# ═══════════════════════════════════════════════════
# 远端解析服务基址，不含 /v1/parse/page；留空时拒绝新 PDF 上传，旧索引仍可查询。
KB_PDF_PARSER_URL=
# 与解析服务使用同一 Bearer 密钥；不提交真实值。
KB_PDF_PARSER_API_KEY=
# 原 PDF、逐页原始 JSON 的持久化目录。留空时使用 backend/agent/data/kb_documents。
KB_DOCUMENT_STORAGE=
# 后端同时处理的 PDF 数量；先保持 1，避免占满远端单页服务。
KB_PDF_CONCURRENCY=1
# 单页 HTTP 读取超时、每次恢复的任务总时限（秒）。停止后不会自动恢复。
KB_PDF_PAGE_TIMEOUT=190
KB_PDF_TASK_TIMEOUT=7200
# 页数、单页像素上限及目标 DPI；大页面会按像素上限缩小。
KB_PDF_MAX_PAGES=500
KB_PDF_MAX_PIXELS=12000000
KB_PDF_RENDER_DPI=144
# embedding 的 /tokenize 完整地址。留空时从 EMBEDDING_BASE_URL 推导。
# 必须是 embedding 模型的 tokenizer，不是聊天模型；不可用时保留检查点并报错。
KB_EMBEDDING_TOKENIZER_URL=
# 完整检索文本（含章节、表头、文件名）的 embedding Token 上限。
KB_DOCUMENT_CHUNK_TOKENS=512
# 各路候选、融合候选、送入精排数量及最终证据数量。
KB_DOCUMENT_RECALL_K=40
# Dense/Sparse 原始候选分别限额；上面的 RECALL_K 是两路融合后的上限。
KB_DOCUMENT_DENSE_K=40
KB_DOCUMENT_SPARSE_K=40
KB_DOCUMENT_LITERAL_K=40
KB_DOCUMENT_METADATA_K=20
KB_DOCUMENT_FUSION_K=40
KB_DOCUMENT_RERANK_K=40
KB_DOCUMENT_EVIDENCE_K=5
# 仅用于成功精排后的筛选；RRF 分数不使用此绝对阈值。精确编号不靠分数判断身份。
# 首版初值，需结合自己的文档做召回/误召回评估。
KB_DOCUMENT_RERANK_MIN_SCORE=0.1
# PDF 结构检索模式：hybrid_structure = 目录软路由 + 内容单元证据包 + 全局检索回退。
# flat 仅使用原平面检索；tree_only 用目录提升候选顺序，不做内容单元扩展（对照评估）。
# 更改后重启后端；旧文档需“重建索引”才有目录结构，无结构的文档仍可按原方式检索。
KB_RETRIEVAL_MODE=hybrid_structure
# 软路由最多选取的文档数、节点数；不扩大工具 Token 预算，显式编号不依赖目录命中。
KB_ROUTE_DOC_TOP_K=3
KB_ROUTE_NODE_TOP_K=6
# 无明确边界段落组的字符上限；命题/证明/表格保留自然边界，模型读取仍受 Token 限制。
# 节点预览为原文字面节选，不是模型摘要。两项变更需重建索引，生成新的结构版本。
KB_UNIT_MAX_CHARS=4000
KB_NODE_PREVIEW_CHARS=120
# 证明子段在叙述边界附近分组的目标字符数，公式和编号不拆开；变更后需重建索引。
KB_PROOF_PASSAGE_CHARS=600
# 以下均为可调正整数，重启后对新请求生效。请求启动时保存快照，失败重试沿用原值。
# 每条用户请求全部 KB 返回的累计 Token 预算；正文、来源、游标和错误元数据共同计数。
# 单次实际额度 = min(该工具上限, 本请求剩余额度, 聊天实际剩余输入空间)。
# task：按需求补查，取消累计 Token/调用次数配额；仍受实际上下文、超时、停止及无进展保护。
# bounded：兼容旧的累计额度和固定轮数；旧请求恢复沿用创建时快照。
KB_EXECUTION_MODE=task
KB_NO_PROGRESS_ROUNDS=3
# 需求更新中模型显式提交的来源编号数上限；可省略 citations 复用 need_ids 已关联来源，不限制实际读过的来源总数。
KB_TASK_CITATION_LIMIT=40
# 连续节点原文按自然块组段，便于分别引用与收尾选择；不修改原文或显式字符读取位置。
KB_READ_PASSAGE_CHARS=1200
# 以下累计限额仅 bounded 模式生效；单次 SEARCH/READ/DIRECTORY 分页上限两种模式均生效。
KB_TURN_TOKENS=4000
# 单次搜索、正文读取、目录返回上限；不会因批量目标或子问题而乘倍。
KB_SEARCH_TOKENS=1000
KB_READ_TOKENS=2000
KB_DIRECTORY_TOKENS=400
# 单次批量读取最多目标数；每个目标单独占一次工具执行额度。
KB_READ_MAX_TARGETS=4
# 正常决策轮数；仅存在参数失败/已请求内容缺失/截断等客观缺口时追加有界补读。
KB_DECISION_MAX_ROUNDS=4
KB_RECOVERY_MAX_ROUNDS=2
# 本请求实际模型调用总上限（含传输重试、独立收尾和空正文补救），建议至少为 3。
# 决策阶段保留最多 2 次给收尾/补救；不保证额度内全部用满，仍受截止时间限制。
KB_MODEL_CALL_LIMIT=8
