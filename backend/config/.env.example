# 复制本文件为 .env 后填入真实值：  cp .env.example .env
# .env 已被 gitignore，不会提交；本示例文件不含任何密钥。

# ═══════════════════════════════════════════════════
# Agent 自动化必需配置
# ═══════════════════════════════════════════════════

# LLM API 地址（任何 OpenAI 兼容接口，需带 /v1）
MODEL_BASE_URL=https://api.openai.com/v1

# LLM API Key
OPENAI_API_KEY=sk-your-key-here

# Agent 调用模式:
#   tool_calls  —— 支持 function calling 的模型（GPT-4o、Claude 等）
#   text_parse  —— 不支持 tool calling 的推理模型（DeepSeek 等），靠 prompt 解析 JSON
#   auto        —— 先试 tool_calls，失败自动降级到 text_parse（推荐）
AGENT_MODE=auto

# ═══════════════════════════════════════════════════
# Embedding（知识库向量召回 + RAG 检索共用）
# ═══════════════════════════════════════════════════

EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=sk-your-key-here
# 模型输出维度须与下方 KNOWLEDGE_VECTOR_SIZE 一致
EMBEDDING_MODEL=text-embedding-3-small

# ═══════════════════════════════════════════════════
# 知识库配置
# ═══════════════════════════════════════════════════

# 存储后端: json(本地文件) | qdrant_mongo(生产，尚未实现)
KNOWLEDGE_BACKEND=json

# 召回综合分阈值（0~1）与返回条数
KNOWLEDGE_MIN_SCORE=0.65
KNOWLEDGE_TOP_K=1

# 向量相似度独立下限：综合分含指纹/域名地板分，同域同页仅靠地板分即可越过
# MIN_SCORE 造成误召回，故对向量另设下限（向量低于此值即使综合分够也不召回）
KNOWLEDGE_VEC_MIN=0.55

# 保存去重阈值：新记录与已有记录相似度≥此值时视为同任务，覆盖更新（避免重复累积）
KNOWLEDGE_DEDUP_SCORE=0.82

# 向量维度（须与 EMBEDDING_MODEL 输出一致；text-embedding-3-small=1536）
KNOWLEDGE_VECTOR_SIZE=1536

# ═══════════════════════════════════════════════════
# RAG / 页面检索（Agent 不依赖，仅网页问答用；不填走默认值）
# ═══════════════════════════════════════════════════

# Qdrant 向量库
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=browser_pages
QDRANT_VECTOR_SIZE=1536
QDRANT_DISTANCE=Cosine

# SearXNG 搜索引擎
SEARXNG_API_URL=http://localhost:8888/search

# 分块参数
PAGE_CHUNK_SIZE=800
PAGE_CHUNK_OVERLAP=100

# ID / 哈希版本种子（改动会使旧向量 ID 失效，一般无需修改）
CHUNKER_VERSION=v1
PAGE_ID_VERSION=v1
CONTENT_HASH_VERSION=v1
SNAPSHOT_ID_VERSION=v1
POINT_ID_VERSION=v1
POINT_NAMESPACE=default_ns

# ═══════════════════════════════════════════════════
# 知识库 qdrant_mongo 后端（未来启用，现留空）
# ═══════════════════════════════════════════════════

KNOWLEDGE_QDRANT_COLLECTION=agent_operations
MONGODB_URL=
MONGODB_DB=browser_agent
