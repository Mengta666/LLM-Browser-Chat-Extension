# 仅用于本部署，不会自动改动 backend/config/.env。
# init 自动生成两份独立密钥；不要复制到聊天记录或公开仓库。
PDF_PARSER_API_KEY=
OCR_VLLM_API_KEY=

# 解析服务对外地址。外部后端访问时改成服务器内网 IP，或 0.0.0.0 并配防火墙。
PDF_PARSER_HOST=127.0.0.1
PDF_PARSER_PORT=19082

# vLLM 默认只在服务器本地开放，通常不需要外部直接访问。
OCR_VLLM_HOST=127.0.0.1
OCR_VLLM_PORT=18083
OCR_VLLM_BASE_URL=http://127.0.0.1:18083/v1
OCR_VLLM_MODEL=PaddlePaddle/PaddleOCR-VL-1.6

# 必填：先看 nvidia-smi，根据空闲显存选择物理 GPU 编号，如 0。
# 不修改原有聊天、embedding、reranker 进程；同卡共享仍须预留显存。
OCR_CUDA_VISIBLE_DEVICES=
OCR_VLLM_GPU_MEMORY_UTILIZATION=0.25
OCR_VLLM_MAX_MODEL_LEN=16384
OCR_VLLM_MAX_NUM_SEQS=2

# prepare-models 下载到配置文件同级 runtime/，启动不自动下载模型。
# 这里是 Paddle 原生版面权重，不是 PP-DocLayoutV3_safetensors。
OCR_LAYOUT_MODEL_DIR=runtime/models/PP-DocLayoutV3
OCR_VLLM_MODEL_DIR=runtime/models/PaddleOCR-VL-1.6

# GPU 映射后的设备编号；gpu:0 指上面所选 GPU，不一定是机器物理 0 号卡。
# 显存不足可先用 cpu 跑版面检测，OCR 仍在 vLLM GPU 上运行。
OCR_LAYOUT_DEVICE=gpu:0
OCR_VLM_CONCURRENCY=2
OCR_MAX_NEW_TOKENS=4096
# 识别图片区域中的文字；这不等于理解流程图箭头或空间关系。
OCR_IMAGE_TEXT=true

# 接收原始 PNG/JPEG 单页；请求 8 MiB、1600 万像素、最多一个在途页面。
PDF_PARSER_MAX_BYTES=8388608
PDF_PARSER_MAX_PIXELS=16000000
PDF_PARSER_PAGE_TIMEOUT=180
PDF_PARSER_STARTUP_TIMEOUT=180

# Docker Compose 专用；与搜索增强 Compose 使用不同项目名。
OCR_COMPOSE_PROJECT_NAME=browser-agent-ocr
OCR_VLLM_IMAGE=browser-agent-ocr-vllm:0.11.1-cu128
OCR_VLLM_CUDA_IMAGE=nvidia/cuda:12.8.1-base-ubuntu24.04
PDF_PARSER_IMAGE=browser-agent-pdf-parser:0.2.0
PDF_PARSER_CUDA_IMAGE=nvidia/cuda:12.6.3-cudnn-runtime-ubuntu24.04
# Docker 内部固定使用 ocr-vllm:8000/v1、/models 和映射后的 gpu:0。
# 上面的 BASE_URL、HOST 和模型路径用于原生部署；容器连接值由 Compose 显式指定。
# PDF_PARSER_HOST/PORT 在 Docker 模式只控制宿主机发布地址，容器内监听 0.0.0.0:8000。
