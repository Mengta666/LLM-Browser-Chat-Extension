# 只管理本项目的可选服务；与后端 backend/config/.env 不会自动同步。
# 修改后需重新执行 docker compose ... up -d 才能更新容器配置。
# 同一台机器部署多套服务时使用不同项目名和端口。
COMPOSE_PROJECT_NAME=browser-agent-addons
# 官方仓库已核对的标签及摘要；升级时一起更新，不自动退回 latest。
SEARXNG_IMAGE=searxng/searxng:2026.9.18-c0042add3@sha256:e0027a772aeeea55bf642256aae6fb3344ffa5f25ca665898c2ea821101334c4
# 搜索服务的宿主机绑定地址；默认仅本机访问，不要匿名暴露公网。
SEARCH_BIND_IP=127.0.0.1
# 搜索服务的宿主机端口；容器内端口固定为 8080。
SEARCH_PORT=19080
# 正文服务的本地构建镜像标签，升级源码后需带 --build 重新部署。
WEB_READER_IMAGE=browser-agent-web-reader:0.2.0
# 默认仅本机访问；跨机器访问时绑定可信网卡地址。
# 0.0.0.0 表示所有 IPv4 网卡，必须配合访问控制；跨不可信网络使用 HTTPS/VPN。
READER_BIND_IP=127.0.0.1
# 正文服务的宿主机端口；容器内端口固定为 8000。
READER_PORT=19081
# 由 init.py 首次生成，至少 32 个 ASCII 字符；后端填写同一个值，禁止提交真实密钥。
WEB_READER_API_KEY=
# 单个 reader 实例允许同时处理的提取请求数（1～16）；不是搜索次数限制。
READER_CONCURRENCY=3
# 单页下载/解压数据上限（字节，64 KiB～8 MiB），不是纳入模型的 token 额度。
READER_MAX_BYTES=2097152
